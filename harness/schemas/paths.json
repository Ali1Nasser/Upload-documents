{
  "v": 1,
  "note": "Globs are repo-relative (** matches any depth); exclude = basename fnmatch patterns skipped. format=jsonl validates every line. validate_written.py only acts on corpus/**.",
  "rules": [
    {
      "glob": "corpus/catalog/files.jsonl",
      "schema": "files",
      "format": "jsonl"
    },
    {
      "glob": "corpus/catalog/media.jsonl",
      "schema": "media",
      "format": "jsonl"
    },
    {
      "glob": "corpus/catalog/quarantine.json",
      "schema": "quarantine",
      "format": "json"
    },
    {
      "glob": "corpus/audio/assets.json",
      "schema": "audio_assets",
      "format": "json"
    },
    {
      "glob": "corpus/transcripts/*.words.jsonl",
      "schema": "words",
      "format": "jsonl"
    },
    {
      "glob": "corpus/sentences/*.jsonl",
      "schema": "sentences",
      "format": "jsonl"
    },
    {
      "glob": "corpus/graph/nodes.jsonl",
      "schema": "graph_node",
      "format": "jsonl"
    },
    {
      "glob": "corpus/graph/edges.jsonl",
      "schema": "graph_edge",
      "format": "jsonl"
    },
    {
      "glob": "corpus/visual/assets.jsonl",
      "schema": "visual_asset",
      "format": "jsonl"
    },
    {
      "glob": "corpus/visual/recaptions.jsonl",
      "schema": "visual_recaption",
      "format": "jsonl"
    },
    {
      "glob": "corpus/edl/master_edl.v*.json",
      "schema": "edl",
      "format": "json"
    },
    {
      "glob": "corpus/edl/word_map.v*.jsonl",
      "schema": "word_map",
      "format": "jsonl"
    },
    {
      "glob": "corpus/specs/*.json",
      "schema": "scene_spec",
      "format": "json",
      "exclude": [
        "manifest.json",
        "_*.json"
      ]
    },
    {
      "glob": "corpus/render/jobs.jsonl",
      "schema": "render_job",
      "format": "jsonl"
    },
    {
      "glob": "reports/qa/**/*.json",
      "schema": "qa_report",
      "format": "json"
    },
    {
      "glob": "harness/state/progress.json",
      "schema": "progress",
      "format": "json"
    },
    {
      "glob": "corpus/canon/knowledge_index.jsonl",
      "schema": "knowledge_index",
      "format": "jsonl"
    },
    {
      "glob": "corpus/canon/crash_course_steps.jsonl",
      "schema": "crash_course_step",
      "format": "jsonl"
    },
    {
      "glob": "corpus/canon/hub_items.jsonl",
      "schema": "hub_item",
      "format": "jsonl"
    },
    {
      "glob": "corpus/canon/hub_shots.jsonl",
      "schema": "hub_shot",
      "format": "jsonl"
    },
    {
      "glob": "corpus/transcripts/*.asr.json",
      "schema": "asr",
      "format": "json"
    },
    {
      "glob": "corpus/transcripts/*.align.json",
      "schema": "align_report",
      "format": "json"
    },
    {
      "glob": "corpus/audio/s2_script_id.json",
      "schema": "s2_script_id",
      "format": "json"
    },
    {
      "glob": "corpus/canon/chapters.json",
      "schema": "canon_chapters",
      "format": "json"
    },
    {
      "glob": "corpus/canon/data_contract.json",
      "schema": "canon_data_contract",
      "format": "json"
    },
    {
      "glob": "corpus/canon/glossary.json",
      "schema": "canon_glossary",
      "format": "json"
    },
    {
      "glob": "corpus/canon/coverage_index.json",
      "schema": "canon_coverage",
      "format": "json"
    },
    {
      "glob": "corpus/canon/assets_registry.json",
      "schema": "canon_assets",
      "format": "json"
    },
    {
      "glob": "corpus/canon/patterns.json",
      "schema": "canon_patterns",
      "format": "json"
    },
    {
      "glob": "corpus/canon/scene_contract.json",
      "schema": "canon_scene_contract",
      "format": "json"
    },
    {
      "glob": "corpus/canon/motion.json",
      "schema": "canon_motion",
      "format": "json"
    },
    {
      "glob": "corpus/canon/spec.json",
      "schema": "canon_spec",
      "format": "json"
    },
    {
      "glob": "corpus/canon/nblm_scenes.jsonl",
      "schema": "nblm_scene",
      "format": "jsonl"
    },
    {
      "glob": "corpus/canon/nblm_parts.json",
      "schema": "nblm_parts",
      "format": "json"
    },
    {
      "glob": "corpus/canon/cues_70m05.json",
      "schema": "cues_70m05",
      "format": "json"
    },
    {
      "glob": "corpus/canon/legacy_shots.jsonl",
      "schema": "legacy_shot",
      "format": "jsonl"
    },
    {
      "glob": "corpus/canon/legacy_patterns.json",
      "schema": "legacy_patterns",
      "format": "json"
    },
    {
      "glob": "corpus/canon/scripts.json",
      "schema": "canon_scripts",
      "format": "json"
    },
    {
      "glob": "corpus/canon/contradictions.json",
      "schema": "canon_contradictions",
      "format": "json"
    },
    {
      "glob": "corpus/text/chunks.jsonl",
      "schema": "chunk",
      "format": "jsonl"
    },
    {
      "glob": "corpus/text/docs.jsonl",
      "schema": "text_doc",
      "format": "jsonl"
    }
  ]
}
