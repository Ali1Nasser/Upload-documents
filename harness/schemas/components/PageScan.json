{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_-]{0,31}$"
  },
  "slot": {
   "type": "string",
   "enum": [
    "full",
    "center",
    "start",
    "end",
    "top",
    "bottom",
    "upper-third",
    "lower-third"
   ]
  },
  "depth": {
   "type": "string",
   "enum": [
    "far",
    "mid",
    "near",
    "fg"
   ]
  },
  "until": {
   "type": "object",
   "properties": {
    "word": {
     "type": "string",
     "pattern": "^w:[A-Za-z0-9]+:[A-Za-z0-9._-]+:\\d{6}$"
    },
    "lead_frames": {
     "type": "integer",
     "minimum": 0,
     "maximum": 90
    }
   },
   "required": [
    "word",
    "lead_frames"
   ],
   "additionalProperties": false
  },
  "pages": {
   "type": "integer",
   "minimum": 1,
   "maximum": 64
  },
  "scan": {
   "type": "string",
   "enum": [
    "full",
    "index",
    "range"
   ]
  },
  "hits": {
   "minItems": 0,
   "maxItems": 64,
   "type": "array",
   "items": {
    "type": "integer",
    "minimum": 0,
    "maximum": 63
   }
  }
 },
 "required": [
  "pages",
  "scan"
 ],
 "additionalProperties": false,
 "$id": "dc:component:PageScan",
 "title": "PageScan",
 "description": "Data pages scanned fully, by index or by range.",
 "x-family": "Domain specials",
 "x-status": "frozen-contract",
 "x-impl": "P7",
 "x-actions": {
  "scan": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "target": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    }
   },
   "additionalProperties": false
  }
 }
}
