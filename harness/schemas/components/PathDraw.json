{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_-]{0,31}$"
  },
  "slot": {
   "type": "string",
   "enum": [
    "full",
    "center",
    "start",
    "end",
    "top",
    "bottom",
    "upper-third",
    "lower-third"
   ]
  },
  "depth": {
   "type": "string",
   "enum": [
    "far",
    "mid",
    "near",
    "fg"
   ]
  },
  "until": {
   "type": "object",
   "properties": {
    "word": {
     "type": "string",
     "pattern": "^w:[A-Za-z0-9]+:[A-Za-z0-9._-]+:\\d{6}$"
    },
    "lead_frames": {
     "type": "integer",
     "minimum": 0,
     "maximum": 90
    }
   },
   "required": [
    "word",
    "lead_frames"
   ],
   "additionalProperties": false
  },
  "d": {
   "type": "string",
   "minLength": 1,
   "maxLength": 4000
  },
  "color": {
   "default": "signal",
   "type": "string",
   "enum": [
    "void",
    "ground",
    "panel",
    "grid",
    "ink",
    "ink2",
    "ink3",
    "signal",
    "ok",
    "warn",
    "crit",
    "violet",
    "ember",
    "paper",
    "paperShade",
    "paperInk",
    "paperOk",
    "paperCrit",
    "white"
   ]
  },
  "width": {
   "default": 3,
   "type": "number",
   "minimum": 1,
   "maximum": 12
  },
  "arrowhead": {
   "default": false,
   "type": "boolean"
  },
  "direction": {
   "type": "string",
   "enum": [
    "rtl",
    "ltr",
    "up",
    "down"
   ]
  }
 },
 "required": [
  "d"
 ],
 "additionalProperties": false,
 "$id": "dc:component:PathDraw",
 "title": "PathDraw",
 "description": "Draw an SVG path (stroke reveal; RTL by default for Arabic layouts).",
 "x-family": "State & FX",
 "x-status": "frozen-contract",
 "x-impl": "P7",
 "x-actions": {}
}
