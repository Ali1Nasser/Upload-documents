{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_-]{0,31}$"
  },
  "slot": {
   "type": "string",
   "enum": [
    "full",
    "center",
    "start",
    "end",
    "top",
    "bottom",
    "upper-third",
    "lower-third"
   ]
  },
  "depth": {
   "type": "string",
   "enum": [
    "far",
    "mid",
    "near",
    "fg"
   ]
  },
  "until": {
   "type": "object",
   "properties": {
    "word": {
     "type": "string",
     "pattern": "^w:[A-Za-z0-9]+:[A-Za-z0-9._-]+:\\d{6}$"
    },
    "lead_frames": {
     "type": "integer",
     "minimum": 0,
     "maximum": 90
    }
   },
   "required": [
    "word",
    "lead_frames"
   ],
   "additionalProperties": false
  },
  "planes": {
   "minItems": 1,
   "maxItems": 12,
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "layer": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,31}$"
     },
     "plane": {
      "type": "string",
      "enum": [
       "far",
       "mid",
       "near",
       "fg"
      ]
     },
     "parallax": {
      "default": 1,
      "type": "number",
      "minimum": 0,
      "maximum": 3
     },
     "blur": {
      "default": 0,
      "type": "number",
      "minimum": 0,
      "maximum": 1
     }
    },
    "required": [
     "layer",
     "plane"
    ],
    "additionalProperties": false
   }
  }
 },
 "required": [
  "planes"
 ],
 "additionalProperties": false,
 "$id": "dc:component:DepthLayers",
 "title": "DepthLayers",
 "description": "Assign layers to depth planes with parallax and fake DOF (blur capped by FX tier).",
 "x-family": "State & FX",
 "x-status": "frozen-contract",
 "x-impl": "P7",
 "x-actions": {}
}
