{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_-]{0,31}$"
  },
  "slot": {
   "type": "string",
   "enum": [
    "full",
    "center",
    "start",
    "end",
    "top",
    "bottom",
    "upper-third",
    "lower-third"
   ]
  },
  "depth": {
   "type": "string",
   "enum": [
    "far",
    "mid",
    "near",
    "fg"
   ]
  },
  "until": {
   "type": "object",
   "properties": {
    "word": {
     "type": "string",
     "pattern": "^w:[A-Za-z0-9]+:[A-Za-z0-9._-]+:\\d{6}$"
    },
    "lead_frames": {
     "type": "integer",
     "minimum": 0,
     "maximum": 90
    }
   },
   "required": [
    "word",
    "lead_frames"
   ],
   "additionalProperties": false
  },
  "direction": {
   "default": "rtl",
   "type": "string",
   "enum": [
    "rtl",
    "ltr",
    "up",
    "down"
   ]
  },
  "motion_blur": {
   "default": false,
   "type": "boolean"
  }
 },
 "additionalProperties": false,
 "$id": "dc:component:WhipPan",
 "title": "WhipPan",
 "description": "Whip-pan transition; CameraMotionBlur on hero tier only.",
 "x-family": "State & FX",
 "x-status": "frozen-contract",
 "x-impl": "P7",
 "x-actions": {}
}
