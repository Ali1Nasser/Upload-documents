{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_-]{0,31}$"
  },
  "slot": {
   "type": "string",
   "enum": [
    "full",
    "center",
    "start",
    "end",
    "top",
    "bottom",
    "upper-third",
    "lower-third"
   ]
  },
  "depth": {
   "type": "string",
   "enum": [
    "far",
    "mid",
    "near",
    "fg"
   ]
  },
  "until": {
   "type": "object",
   "properties": {
    "word": {
     "type": "string",
     "pattern": "^w:[A-Za-z0-9]+:[A-Za-z0-9._-]+:\\d{6}$"
    },
    "lead_frames": {
     "type": "integer",
     "minimum": 0,
     "maximum": 90
    }
   },
   "required": [
    "word",
    "lead_frames"
   ],
   "additionalProperties": false
  },
  "series": {
   "minItems": 1,
   "maxItems": 12,
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[^\\u0660-\\u0669\\u06F0-\\u06F9]*$"
     },
     "value": {
      "type": "object",
      "properties": {
       "value": {
        "type": "number"
       },
       "ref": {
        "anyOf": [
         {
          "type": "string",
          "pattern": "^d:\\d+(\\.\\d+)*:\\d+$"
         },
         {
          "type": "string",
          "pattern": "^s:[A-Za-z0-9]+:[A-Za-z0-9._-]+:\\d{4}$"
         }
        ]
       },
       "unit": {
        "type": "string",
        "maxLength": 12
       },
       "decimals": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4
       }
      },
      "required": [
       "value",
       "ref"
      ],
      "additionalProperties": false
     },
     "color": {
      "type": "string",
      "enum": [
       "void",
       "ground",
       "panel",
       "grid",
       "ink",
       "ink2",
       "ink3",
       "signal",
       "ok",
       "warn",
       "crit",
       "violet",
       "ember",
       "paper",
       "paperShade",
       "paperInk",
       "paperOk",
       "paperCrit",
       "white"
      ]
     }
    },
    "required": [
     "label",
     "value"
    ],
    "additionalProperties": false
   }
  },
  "orientation": {
   "default": "h",
   "type": "string",
   "enum": [
    "h",
    "v"
   ]
  },
  "stacked": {
   "default": false,
   "type": "boolean"
  },
  "sort": {
   "default": "none",
   "type": "string",
   "enum": [
    "none",
    "asc",
    "desc"
   ]
  }
 },
 "required": [
  "series"
 ],
 "additionalProperties": false,
 "$id": "dc:component:BarStack",
 "title": "BarStack",
 "description": "Bars (single or stacked) with token colours; values carry refs.",
 "x-family": "Data",
 "x-status": "frozen-contract",
 "x-impl": "P7",
 "x-actions": {
  "grow": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "target": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    }
   },
   "additionalProperties": false
  },
  "highlight": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "target": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    },
    "index": {
     "type": "integer",
     "minimum": 0,
     "maximum": 11
    },
    "color": {
     "default": "signal",
     "type": "string",
     "enum": [
      "void",
      "ground",
      "panel",
      "grid",
      "ink",
      "ink2",
      "ink3",
      "signal",
      "ok",
      "warn",
      "crit",
      "violet",
      "ember",
      "paper",
      "paperShade",
      "paperInk",
      "paperOk",
      "paperCrit",
      "white"
     ]
    }
   },
   "required": [
    "index"
   ],
   "additionalProperties": false
  }
 }
}
