{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_-]{0,31}$"
  },
  "slot": {
   "type": "string",
   "enum": [
    "full",
    "center",
    "start",
    "end",
    "top",
    "bottom",
    "upper-third",
    "lower-third"
   ]
  },
  "depth": {
   "type": "string",
   "enum": [
    "far",
    "mid",
    "near",
    "fg"
   ]
  },
  "until": {
   "type": "object",
   "properties": {
    "word": {
     "type": "string",
     "pattern": "^w:[A-Za-z0-9]+:[A-Za-z0-9._-]+:\\d{6}$"
    },
    "lead_frames": {
     "type": "integer",
     "minimum": 0,
     "maximum": 90
    }
   },
   "required": [
    "word",
    "lead_frames"
   ],
   "additionalProperties": false
  },
  "frames": {
   "minItems": 0,
   "maxItems": 10,
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[^\\u0660-\\u0669\\u06F0-\\u06F9]*$"
     },
     "vars": {
      "minItems": 0,
      "maxItems": 6,
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1,
       "maxLength": 40,
       "pattern": "^[^\\u0660-\\u0669\\u06F0-\\u06F9]*$"
      }
     }
    },
    "required": [
     "label"
    ],
    "additionalProperties": false
   }
  },
  "heap": {
   "minItems": 0,
   "maxItems": 12,
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,31}$"
     },
     "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[^\\u0660-\\u0669\\u06F0-\\u06F9]*$"
     }
    },
    "required": [
     "id",
     "label"
    ],
    "additionalProperties": false
   }
  },
  "refs": {
   "minItems": 0,
   "maxItems": 24,
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "from": {
      "type": "string",
      "maxLength": 32
     },
     "to": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,31}$"
     }
    },
    "required": [
     "from",
     "to"
    ],
    "additionalProperties": false
   }
  }
 },
 "required": [
  "frames",
  "heap",
  "refs"
 ],
 "additionalProperties": false,
 "$id": "dc:component:StackHeap",
 "title": "StackHeap",
 "description": "Call stack frames and heap objects with references.",
 "x-family": "Structure & flow",
 "x-status": "frozen-contract",
 "x-impl": "P7",
 "x-actions": {
  "push": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "target": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    },
    "label": {
     "type": "string",
     "minLength": 1,
     "maxLength": 40,
     "pattern": "^[^\\u0660-\\u0669\\u06F0-\\u06F9]*$"
    }
   },
   "required": [
    "label"
   ],
   "additionalProperties": false
  },
  "pop": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "target": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    }
   },
   "additionalProperties": false
  },
  "collect": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "target": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    },
    "node": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    }
   },
   "required": [
    "node"
   ],
   "additionalProperties": false
  }
 }
}
