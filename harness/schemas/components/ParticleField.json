{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_-]{0,31}$"
  },
  "slot": {
   "type": "string",
   "enum": [
    "full",
    "center",
    "start",
    "end",
    "top",
    "bottom",
    "upper-third",
    "lower-third"
   ]
  },
  "depth": {
   "type": "string",
   "enum": [
    "far",
    "mid",
    "near",
    "fg"
   ]
  },
  "until": {
   "type": "object",
   "properties": {
    "word": {
     "type": "string",
     "pattern": "^w:[A-Za-z0-9]+:[A-Za-z0-9._-]+:\\d{6}$"
    },
    "lead_frames": {
     "type": "integer",
     "minimum": 0,
     "maximum": 90
    }
   },
   "required": [
    "word",
    "lead_frames"
   ],
   "additionalProperties": false
  },
  "count": {
   "default": 400,
   "type": "integer",
   "minimum": 0,
   "maximum": 1500
  },
  "kind": {
   "default": "dust",
   "type": "string",
   "enum": [
    "dust",
    "data",
    "sparks",
    "snow"
   ]
  },
  "color": {
   "default": "signal",
   "type": "string",
   "enum": [
    "void",
    "ground",
    "panel",
    "grid",
    "ink",
    "ink2",
    "ink3",
    "signal",
    "ok",
    "warn",
    "crit",
    "violet",
    "ember",
    "paper",
    "paperShade",
    "paperInk",
    "paperOk",
    "paperCrit",
    "white"
   ]
  },
  "seed": {
   "type": "integer",
   "minimum": 0,
   "maximum": 2147483647
  }
 },
 "required": [
  "seed"
 ],
 "additionalProperties": false,
 "$id": "dc:component:ParticleField",
 "title": "ParticleField",
 "description": "Seeded ambient particles (text-safe masked).",
 "x-family": "Space & 3D",
 "x-status": "frozen-contract",
 "x-impl": "P7",
 "x-actions": {}
}
