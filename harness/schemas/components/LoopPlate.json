{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_-]{0,31}$"
  },
  "slot": {
   "type": "string",
   "enum": [
    "full",
    "center",
    "start",
    "end",
    "top",
    "bottom",
    "upper-third",
    "lower-third"
   ]
  },
  "depth": {
   "type": "string",
   "enum": [
    "far",
    "mid",
    "near",
    "fg"
   ]
  },
  "until": {
   "type": "object",
   "properties": {
    "word": {
     "type": "string",
     "pattern": "^w:[A-Za-z0-9]+:[A-Za-z0-9._-]+:\\d{6}$"
    },
    "lead_frames": {
     "type": "integer",
     "minimum": 0,
     "maximum": 90
    }
   },
   "required": [
    "word",
    "lead_frames"
   ],
   "additionalProperties": false
  },
  "plate": {
   "type": "string",
   "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
  },
  "opacity": {
   "default": 1,
   "type": "number",
   "minimum": 0,
   "maximum": 1
  },
  "blend": {
   "default": "normal",
   "type": "string",
   "enum": [
    "normal",
    "screen",
    "add"
   ]
  },
  "speed": {
   "default": 1,
   "type": "number",
   "minimum": 0.5,
   "maximum": 2
  }
 },
 "required": [
  "plate"
 ],
 "additionalProperties": false,
 "$id": "dc:component:LoopPlate",
 "title": "LoopPlate",
 "description": "A pre-rendered seamless 10 s loop from data/derived/plates/ (dc render plate <name>).",
 "x-family": "Media",
 "x-status": "frozen-contract",
 "x-impl": "P7",
 "x-actions": {}
}
