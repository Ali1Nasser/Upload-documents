{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_-]{0,31}$"
  },
  "slot": {
   "type": "string",
   "enum": [
    "full",
    "center",
    "start",
    "end",
    "top",
    "bottom",
    "upper-third",
    "lower-third"
   ]
  },
  "depth": {
   "type": "string",
   "enum": [
    "far",
    "mid",
    "near",
    "fg"
   ]
  },
  "until": {
   "type": "object",
   "properties": {
    "word": {
     "type": "string",
     "pattern": "^w:[A-Za-z0-9]+:[A-Za-z0-9._-]+:\\d{6}$"
    },
    "lead_frames": {
     "type": "integer",
     "minimum": 0,
     "maximum": 90
    }
   },
   "required": [
    "word",
    "lead_frames"
   ],
   "additionalProperties": false
  },
  "to": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_-]{0,31}(\\.[A-Za-z0-9_-]+)?$"
  },
  "shape": {
   "default": "rect",
   "type": "string",
   "enum": [
    "circle",
    "rect"
   ]
  },
  "dim": {
   "default": 0.6,
   "type": "number",
   "minimum": 0,
   "maximum": 0.85
  }
 },
 "required": [
  "to"
 ],
 "additionalProperties": false,
 "$id": "dc:component:Spotlight",
 "title": "Spotlight",
 "description": "Dim everything except a target layer or part.",
 "x-family": "Type & UI",
 "x-status": "frozen-contract",
 "x-impl": "P7",
 "x-actions": {}
}
