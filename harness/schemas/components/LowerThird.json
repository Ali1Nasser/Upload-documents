{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_-]{0,31}$"
  },
  "slot": {
   "type": "string",
   "enum": [
    "full",
    "center",
    "start",
    "end",
    "top",
    "bottom",
    "upper-third",
    "lower-third"
   ]
  },
  "depth": {
   "type": "string",
   "enum": [
    "far",
    "mid",
    "near",
    "fg"
   ]
  },
  "until": {
   "type": "object",
   "properties": {
    "word": {
     "type": "string",
     "pattern": "^w:[A-Za-z0-9]+:[A-Za-z0-9._-]+:\\d{6}$"
    },
    "lead_frames": {
     "type": "integer",
     "minimum": 0,
     "maximum": 90
    }
   },
   "required": [
    "word",
    "lead_frames"
   ],
   "additionalProperties": false
  },
  "title": {
   "type": "string",
   "minLength": 1,
   "maxLength": 48,
   "pattern": "^[^\\u0660-\\u0669\\u06F0-\\u06F9]*$"
  },
  "subtitle": {
   "type": "string",
   "minLength": 1,
   "maxLength": 64,
   "pattern": "^[^\\u0660-\\u0669\\u06F0-\\u06F9]*$"
  },
  "kind": {
   "default": "term",
   "type": "string",
   "enum": [
    "source",
    "term",
    "speaker",
    "location"
   ]
  }
 },
 "required": [
  "title"
 ],
 "additionalProperties": false,
 "$id": "dc:component:LowerThird",
 "title": "LowerThird",
 "description": "Lower-third caption for a source, term, speaker or location.",
 "x-family": "Type & UI",
 "x-status": "frozen-contract",
 "x-impl": "P7",
 "x-actions": {}
}
