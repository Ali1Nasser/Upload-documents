     "pattern": "^[^\\u0660-\\u0669\\u06F0-\\u06F9]*$"
    },
    "resource": {
     "type": "string",
     "minLength": 1,
     "maxLength": 40,
     "pattern": "^[^\\u0660-\\u0669\\u06F0-\\u06F9]*$"
    },
    "level": {
     "type": "string",
     "enum": [
      "read",
      "write",
