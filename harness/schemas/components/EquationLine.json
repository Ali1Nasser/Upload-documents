{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_-]{0,31}$"
  },
  "slot": {
   "type": "string",
   "enum": [
    "full",
    "center",
    "start",
    "end",
    "top",
    "bottom",
    "upper-third",
    "lower-third"
   ]
  },
  "depth": {
   "type": "string",
   "enum": [
    "far",
    "mid",
    "near",
    "fg"
   ]
  },
  "until": {
   "type": "object",
   "properties": {
    "word": {
     "type": "string",
     "pattern": "^w:[A-Za-z0-9]+:[A-Za-z0-9._-]+:\\d{6}$"
    },
    "lead_frames": {
     "type": "integer",
     "minimum": 0,
     "maximum": 90
    }
   },
   "required": [
    "word",
    "lead_frames"
   ],
   "additionalProperties": false
  },
  "terms": {
   "minItems": 1,
   "maxItems": 9,
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 24,
      "pattern": "^[^\\u0660-\\u0669\\u06F0-\\u06F9]*$"
     },
     "kind": {
      "type": "string",
      "enum": [
       "operand",
       "operator",
       "result"
      ]
     },
     "ref": {
      "anyOf": [
       {
        "type": "string",
        "pattern": "^d:\\d+(\\.\\d+)*:\\d+$"
       },
       {
        "type": "string",
        "pattern": "^s:[A-Za-z0-9]+:[A-Za-z0-9._-]+:\\d{4}$"
       }
      ]
     },
     "at": {
      "type": "object",
      "properties": {
       "word": {
        "type": "string",
        "pattern": "^w:[A-Za-z0-9]+:[A-Za-z0-9._-]+:\\d{6}$"
       },
       "lead_frames": {
        "type": "integer",
        "minimum": 0,
        "maximum": 90
       }
      },
      "required": [
       "word",
       "lead_frames"
      ],
      "additionalProperties": false
     }
    },
    "required": [
     "text",
     "kind"
    ],
    "additionalProperties": false
   }
  },
  "size": {
   "default": "sub",
   "type": "string",
   "enum": [
    "hero",
    "impact",
    "title",
    "kinetic",
    "sub",
    "body",
    "label",
    "labelMin",
    "secondaryMin",
    "numberHero",
    "numberBig"
   ]
  }
 },
 "required": [
  "terms"
 ],
 "additionalProperties": false,
 "$id": "dc:component:EquationLine",
 "title": "EquationLine",
 "description": "A formula laid out LTR in an isolate; operators use U+2212 minus; terms can arrive on anchors.",
 "x-family": "Type & UI",
 "x-status": "frozen-contract",
 "x-impl": "P7",
 "x-actions": {}
}
