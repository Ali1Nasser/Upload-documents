{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_-]{0,31}$"
  },
  "slot": {
   "type": "string",
   "enum": [
    "full",
    "center",
    "start",
    "end",
    "top",
    "bottom",
    "upper-third",
    "lower-third"
   ]
  },
  "depth": {
   "type": "string",
   "enum": [
    "far",
    "mid",
    "near",
    "fg"
   ]
  },
  "until": {
   "type": "object",
   "properties": {
    "word": {
     "type": "string",
     "pattern": "^w:[A-Za-z0-9]+:[A-Za-z0-9._-]+:\\d{6}$"
    },
    "lead_frames": {
     "type": "integer",
     "minimum": 0,
     "maximum": 90
    }
   },
   "required": [
    "word",
    "lead_frames"
   ],
   "additionalProperties": false
  },
  "gates": {
   "type": "array",
   "prefixItems": [
    {
     "type": "object",
     "properties": {
      "label": {
       "type": "string",
       "minLength": 1,
       "maxLength": 40,
       "pattern": "^[^\\u0660-\\u0669\\u06F0-\\u06F9]*$"
      },
      "state": {
       "type": "string",
       "enum": [
        "dormant",
        "open",
        "closed",
        "fail"
       ]
      }
     },
     "required": [
      "label"
     ],
     "additionalProperties": false
    },
    {
     "type": "object",
     "properties": {
      "label": {
       "type": "string",
       "minLength": 1,
       "maxLength": 40,
       "pattern": "^[^\\u0660-\\u0669\\u06F0-\\u06F9]*$"
      },
      "state": {
       "type": "string",
       "enum": [
        "dormant",
        "open",
        "closed",
        "fail"
       ]
      }
     },
     "required": [
      "label"
     ],
     "additionalProperties": false
    },
    {
     "type": "object",
     "properties": {
      "label": {
       "type": "string",
       "minLength": 1,
       "maxLength": 40,
       "pattern": "^[^\\u0660-\\u0669\\u06F0-\\u06F9]*$"
      },
      "state": {
       "type": "string",
       "enum": [
        "dormant",
        "open",
        "closed",
        "fail"
       ]
      }
     },
     "required": [
      "label"
     ],
     "additionalProperties": false
    }
   ],
   "items": false,
   "minItems": 3,
   "maxItems": 3
  },
  "payload": {
   "type": "string",
   "minLength": 1,
   "maxLength": 40,
   "pattern": "^[^\\u0660-\\u0669\\u06F0-\\u06F9]*$"
  }
 },
 "required": [
  "gates"
 ],
 "additionalProperties": false,
 "$id": "dc:component:TripleGate",
 "title": "TripleGate",
 "description": "Three gates (e.g. validate -> authorise -> settle) that ignite in turn; a payload passes or is rejected.",
 "x-family": "Domain specials",
 "x-status": "frozen-contract",
 "x-impl": "P7",
 "x-actions": {
  "ignite": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "target": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    },
    "gate": {
     "anyOf": [
      {
       "type": "integer",
       "minimum": 0,
       "maximum": 2
      },
      {
       "type": "string",
       "const": "all"
      }
     ]
    }
   },
   "required": [
    "gate"
   ],
   "additionalProperties": false
  },
  "pass": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "target": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    }
   },
   "additionalProperties": false
  },
  "reject": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "target": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    },
    "gate": {
     "type": "integer",
     "minimum": 0,
     "maximum": 2
    }
   },
   "required": [
    "gate"
   ],
   "additionalProperties": false
  }
 }
}
