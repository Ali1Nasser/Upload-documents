{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_-]{0,31}$"
  },
  "slot": {
   "type": "string",
   "enum": [
    "full",
    "center",
    "start",
    "end",
    "top",
    "bottom",
    "upper-third",
    "lower-third"
   ]
  },
  "depth": {
   "type": "string",
   "enum": [
    "far",
    "mid",
    "near",
    "fg"
   ]
  },
  "until": {
   "type": "object",
   "properties": {
    "word": {
     "type": "string",
     "pattern": "^w:[A-Za-z0-9]+:[A-Za-z0-9._-]+:\\d{6}$"
    },
    "lead_frames": {
     "type": "integer",
     "minimum": 0,
     "maximum": 90
    }
   },
   "required": [
    "word",
    "lead_frames"
   ],
   "additionalProperties": false
  },
  "tests": {
   "minItems": 1,
   "maxItems": 12,
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "name": {
      "type": "string",
      "maxLength": 48
     },
     "status": {
      "type": "string",
      "enum": [
       "pending",
       "pass",
       "fail",
       "skip"
      ]
     }
    },
    "required": [
     "name",
     "status"
    ],
    "additionalProperties": false
   }
  }
 },
 "required": [
  "tests"
 ],
 "additionalProperties": false,
 "$id": "dc:component:TestGate",
 "title": "TestGate",
 "description": "Tests that run and pass, fail or skip before a merge gate.",
 "x-family": "Domain specials",
 "x-status": "frozen-contract",
 "x-impl": "P7",
 "x-actions": {
  "run": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "target": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    }
   },
   "additionalProperties": false
  },
  "fail": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "target": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    },
    "index": {
     "type": "integer",
     "minimum": 0,
     "maximum": 11
    }
   },
   "required": [
    "index"
   ],
   "additionalProperties": false
  }
 }
}
