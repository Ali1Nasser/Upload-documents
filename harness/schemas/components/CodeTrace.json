{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_-]{0,31}$"
  },
  "slot": {
   "type": "string",
   "enum": [
    "full",
    "center",
    "start",
    "end",
    "top",
    "bottom",
    "upper-third",
    "lower-third"
   ]
  },
  "depth": {
   "type": "string",
   "enum": [
    "far",
    "mid",
    "near",
    "fg"
   ]
  },
  "until": {
   "type": "object",
   "properties": {
    "word": {
     "type": "string",
     "pattern": "^w:[A-Za-z0-9]+:[A-Za-z0-9._-]+:\\d{6}$"
    },
    "lead_frames": {
     "type": "integer",
     "minimum": 0,
     "maximum": 90
    }
   },
   "required": [
    "word",
    "lead_frames"
   ],
   "additionalProperties": false
  },
  "lang": {
   "type": "string",
   "enum": [
    "sql",
    "python",
    "js",
    "ts",
    "bash",
    "yaml",
    "json",
    "dockerfile",
    "scala",
    "java",
    "go",
    "other"
   ]
  },
  "code": {
   "type": "string",
   "minLength": 1,
   "maxLength": 2400
  },
  "highlights": {
   "minItems": 0,
   "maxItems": 12,
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "lines": {
      "type": "array",
      "prefixItems": [
       {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
       },
       {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
       }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
     },
     "at": {
      "type": "object",
      "properties": {
       "word": {
        "type": "string",
        "pattern": "^w:[A-Za-z0-9]+:[A-Za-z0-9._-]+:\\d{6}$"
       },
       "lead_frames": {
        "type": "integer",
        "minimum": 0,
        "maximum": 90
       }
      },
      "required": [
       "word",
       "lead_frames"
      ],
      "additionalProperties": false
     },
     "note_ar": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[^\\u0660-\\u0669\\u06F0-\\u06F9]*$"
     }
    },
    "required": [
     "lines",
     "at"
    ],
    "additionalProperties": false
   }
  }
 },
 "required": [
  "lang",
  "code"
 ],
 "additionalProperties": false,
 "$id": "dc:component:CodeTrace",
 "title": "CodeTrace",
 "description": "A code block (<= 30 lines) with line highlights stepped on anchors.",
 "x-family": "Code",
 "x-status": "frozen-contract",
 "x-impl": "P7",
 "x-actions": {
  "step": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "target": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    },
    "line": {
     "type": "integer",
     "minimum": 1,
     "maximum": 30
    }
   },
   "required": [
    "line"
   ],
   "additionalProperties": false
  }
 }
}
