{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_-]{0,31}$"
  },
  "slot": {
   "type": "string",
   "enum": [
    "full",
    "center",
    "start",
    "end",
    "top",
    "bottom",
    "upper-third",
    "lower-third"
   ]
  },
  "depth": {
   "type": "string",
   "enum": [
    "far",
    "mid",
    "near",
    "fg"
   ]
  },
  "until": {
   "type": "object",
   "properties": {
    "word": {
     "type": "string",
     "pattern": "^w:[A-Za-z0-9]+:[A-Za-z0-9._-]+:\\d{6}$"
    },
    "lead_frames": {
     "type": "integer",
     "minimum": 0,
     "maximum": 90
    }
   },
   "required": [
    "word",
    "lead_frames"
   ],
   "additionalProperties": false
  },
  "tokens": {
   "minItems": 2,
   "maxItems": 16,
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1,
    "maxLength": 20,
    "pattern": "^[^\\u0660-\\u0669\\u06F0-\\u06F9]*$"
   }
  },
  "matrix": {
   "maxItems": 16,
   "type": "array",
   "items": {
    "maxItems": 16,
    "type": "array",
    "items": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    }
   }
  },
  "head": {
   "type": "string",
   "minLength": 1,
   "maxLength": 40,
   "pattern": "^[^\\u0660-\\u0669\\u06F0-\\u06F9]*$"
  },
  "ref": {
   "anyOf": [
    {
     "type": "string",
     "pattern": "^d:\\d+(\\.\\d+)*:\\d+$"
    },
    {
     "type": "string",
     "pattern": "^s:[A-Za-z0-9]+:[A-Za-z0-9._-]+:\\d{4}$"
    }
   ]
  }
 },
 "required": [
  "tokens"
 ],
 "additionalProperties": false,
 "$id": "dc:component:AttentionMatrix",
 "title": "AttentionMatrix",
 "description": "A token x token attention matrix (<= 16 tokens).",
 "x-family": "Space & 3D",
 "x-status": "frozen-contract",
 "x-impl": "P7",
 "x-actions": {
  "highlightRow": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "target": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    },
    "index": {
     "type": "integer",
     "minimum": 0,
     "maximum": 15
    }
   },
   "required": [
    "index"
   ],
   "additionalProperties": false
  }
 }
}
