{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_-]{0,31}$"
  },
  "slot": {
   "type": "string",
   "enum": [
    "full",
    "center",
    "start",
    "end",
    "top",
    "bottom",
    "upper-third",
    "lower-third"
   ]
  },
  "depth": {
   "type": "string",
   "enum": [
    "far",
    "mid",
    "near",
    "fg"
   ]
  },
  "until": {
   "type": "object",
   "properties": {
    "word": {
     "type": "string",
     "pattern": "^w:[A-Za-z0-9]+:[A-Za-z0-9._-]+:\\d{6}$"
    },
    "lead_frames": {
     "type": "integer",
     "minimum": 0,
     "maximum": 90
    }
   },
   "required": [
    "word",
    "lead_frames"
   ],
   "additionalProperties": false
  },
  "tasks": {
   "minItems": 1,
   "maxItems": 24,
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,31}$"
     },
     "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[^\\u0660-\\u0669\\u06F0-\\u06F9]*$"
     }
    },
    "required": [
     "id",
     "label"
    ],
    "additionalProperties": false
   }
  },
  "deps": {
   "minItems": 0,
   "maxItems": 48,
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "from": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,31}$"
     },
     "to": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,31}$"
     }
    },
    "required": [
     "from",
     "to"
    ],
    "additionalProperties": false
   }
  },
  "schedule": {
   "type": "string",
   "minLength": 1,
   "maxLength": 40,
   "pattern": "^[^\\u0660-\\u0669\\u06F0-\\u06F9]*$"
  }
 },
 "required": [
  "tasks",
  "deps"
 ],
 "additionalProperties": false,
 "$id": "dc:component:DagRun",
 "title": "DagRun",
 "description": "A DAG of tasks whose states change on anchors (queued/running/success/failed/retry/skipped).",
 "x-family": "Structure & flow",
 "x-status": "frozen-contract",
 "x-impl": "P7",
 "x-actions": {
  "setState": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "target": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    },
    "task": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    },
    "state": {
     "type": "string",
     "enum": [
      "queued",
      "running",
      "success",
      "failed",
      "retry",
      "skipped"
     ]
    }
   },
   "required": [
    "task",
    "state"
   ],
   "additionalProperties": false
  }
 }
}
