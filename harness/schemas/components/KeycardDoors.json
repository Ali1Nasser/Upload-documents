{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_-]{0,31}$"
  },
  "slot": {
   "type": "string",
   "enum": [
    "full",
    "center",
    "start",
    "end",
    "top",
    "bottom",
    "upper-third",
    "lower-third"
   ]
  },
  "depth": {
   "type": "string",
   "enum": [
    "far",
    "mid",
    "near",
    "fg"
   ]
  },
  "until": {
   "type": "object",
   "properties": {
    "word": {
     "type": "string",
     "pattern": "^w:[A-Za-z0-9]+:[A-Za-z0-9._-]+:\\d{6}$"
    },
    "lead_frames": {
     "type": "integer",
     "minimum": 0,
     "maximum": 90
    }
   },
   "required": [
    "word",
    "lead_frames"
   ],
   "additionalProperties": false
  },
  "doors": {
   "minItems": 1,
   "maxItems": 6,
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[^\\u0660-\\u0669\\u06F0-\\u06F9]*$"
     },
     "level": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
     }
    },
    "required": [
     "label",
     "level"
    ],
    "additionalProperties": false
   }
  },
  "card": {
   "type": "integer",
   "minimum": 0,
   "maximum": 5
  }
 },
 "required": [
  "doors",
  "card"
 ],
 "additionalProperties": false,
 "$id": "dc:component:KeycardDoors",
 "title": "KeycardDoors",
 "description": "Doors by clearance level; a keycard opens some.",
 "x-family": "Domain specials",
 "x-status": "frozen-contract",
 "x-impl": "P7",
 "x-actions": {
  "swipe": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "target": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    },
    "door": {
     "type": "integer",
     "minimum": 0,
     "maximum": 5
    }
   },
   "required": [
    "door"
   ],
   "additionalProperties": false
  }
 }
}
