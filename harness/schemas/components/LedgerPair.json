{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_-]{0,31}$"
  },
  "slot": {
   "type": "string",
   "enum": [
    "full",
    "center",
    "start",
    "end",
    "top",
    "bottom",
    "upper-third",
    "lower-third"
   ]
  },
  "depth": {
   "type": "string",
   "enum": [
    "far",
    "mid",
    "near",
    "fg"
   ]
  },
  "until": {
   "type": "object",
   "properties": {
    "word": {
     "type": "string",
     "pattern": "^w:[A-Za-z0-9]+:[A-Za-z0-9._-]+:\\d{6}$"
    },
    "lead_frames": {
     "type": "integer",
     "minimum": 0,
     "maximum": 90
    }
   },
   "required": [
    "word",
    "lead_frames"
   ],
   "additionalProperties": false
  },
  "left": {
   "type": "object",
   "properties": {
    "label": {
     "type": "string",
     "minLength": 1,
     "maxLength": 40,
     "pattern": "^[^\\u0660-\\u0669\\u06F0-\\u06F9]*$"
    },
    "entries": {
     "minItems": 1,
     "maxItems": 8,
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "label": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40,
        "pattern": "^[^\\u0660-\\u0669\\u06F0-\\u06F9]*$"
       },
       "amount": {
        "type": "object",
        "properties": {
         "value": {
          "type": "number"
         },
         "ref": {
          "anyOf": [
           {
            "type": "string",
            "pattern": "^d:\\d+(\\.\\d+)*:\\d+$"
           },
           {
            "type": "string",
            "pattern": "^s:[A-Za-z0-9]+:[A-Za-z0-9._-]+:\\d{4}$"
           }
          ]
         },
         "unit": {
          "type": "string",
          "maxLength": 12
         },
         "decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
         }
        },
        "required": [
         "value",
         "ref"
        ],
        "additionalProperties": false
       }
      },
      "required": [
       "label",
       "amount"
      ],
      "additionalProperties": false
     }
    }
   },
   "required": [
    "label",
    "entries"
   ],
   "additionalProperties": false
  },
  "right": {
   "type": "object",
   "properties": {
    "label": {
     "type": "string",
     "minLength": 1,
     "maxLength": 40,
     "pattern": "^[^\\u0660-\\u0669\\u06F0-\\u06F9]*$"
    },
    "entries": {
     "minItems": 1,
     "maxItems": 8,
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "label": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40,
        "pattern": "^[^\\u0660-\\u0669\\u06F0-\\u06F9]*$"
       },
       "amount": {
        "type": "object",
        "properties": {
         "value": {
          "type": "number"
         },
         "ref": {
          "anyOf": [
           {
            "type": "string",
            "pattern": "^d:\\d+(\\.\\d+)*:\\d+$"
           },
           {
            "type": "string",
            "pattern": "^s:[A-Za-z0-9]+:[A-Za-z0-9._-]+:\\d{4}$"
           }
          ]
         },
         "unit": {
          "type": "string",
          "maxLength": 12
         },
         "decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
         }
        },
        "required": [
         "value",
         "ref"
        ],
        "additionalProperties": false
       }
      },
      "required": [
       "label",
       "amount"
      ],
      "additionalProperties": false
     }
    }
   },
   "required": [
    "label",
    "entries"
   ],
   "additionalProperties": false
  }
 },
 "required": [
  "left",
  "right"
 ],
 "additionalProperties": false,
 "$id": "dc:component:LedgerPair",
 "title": "LedgerPair",
 "description": "Two ledgers side by side (source vs target) that reconcile or expose a mismatch.",
 "x-family": "Data",
 "x-status": "frozen-contract",
 "x-impl": "P7",
 "x-actions": {
  "reconcile": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "target": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    }
   },
   "additionalProperties": false
  },
  "mismatch": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "target": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    },
    "index": {
     "type": "integer",
     "minimum": 0,
     "maximum": 7
    }
   },
   "required": [
    "index"
   ],
   "additionalProperties": false
  }
 }
}
