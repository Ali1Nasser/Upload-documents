{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_-]{0,31}$"
  },
  "slot": {
   "type": "string",
   "enum": [
    "full",
    "center",
    "start",
    "end",
    "top",
    "bottom",
    "upper-third",
    "lower-third"
   ]
  },
  "depth": {
   "type": "string",
   "enum": [
    "far",
    "mid",
    "near",
    "fg"
   ]
  },
  "until": {
   "type": "object",
   "properties": {
    "word": {
     "type": "string",
     "pattern": "^w:[A-Za-z0-9]+:[A-Za-z0-9._-]+:\\d{6}$"
    },
    "lead_frames": {
     "type": "integer",
     "minimum": 0,
     "maximum": 90
    }
   },
   "required": [
    "word",
    "lead_frames"
   ],
   "additionalProperties": false
  },
  "chapter": {
   "type": "string",
   "pattern": "^(CH-\\d{2}|DD-P\\d{2}(-\\d+)?)$"
  },
  "parent": {
   "type": "string",
   "pattern": "^(CH-\\d{2}|DD-P\\d{2}(-\\d+)?)$"
  },
  "title_ar": {
   "type": "string",
   "minLength": 1,
   "maxLength": 48,
   "pattern": "^[^\\u0660-\\u0669\\u06F0-\\u06F9]*$"
  },
  "title_en": {
   "type": "string",
   "minLength": 1,
   "maxLength": 48,
   "pattern": "^[^\\u0660-\\u0669\\u06F0-\\u06F9]*$"
  },
  "prerequisites": {
   "minItems": 0,
   "maxItems": 6,
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^c:[a-z0-9]+(-[a-z0-9]+)*$"
   }
  }
 },
 "required": [
  "chapter",
  "parent",
  "title_ar"
 ],
 "additionalProperties": false,
 "$id": "dc:component:DeepDiveCard",
 "title": "DeepDiveCard",
 "description": "Deep-Dive entry card with parent chapter and prerequisite concepts.",
 "x-family": "Type & UI",
 "x-status": "frozen-contract",
 "x-impl": "P7",
 "x-actions": {}
}
