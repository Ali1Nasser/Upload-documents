{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_-]{0,31}$"
  },
  "slot": {
   "type": "string",
   "enum": [
    "full",
    "center",
    "start",
    "end",
    "top",
    "bottom",
    "upper-third",
    "lower-third"
   ]
  },
  "depth": {
   "type": "string",
   "enum": [
    "far",
    "mid",
    "near",
    "fg"
   ]
  },
  "until": {
   "type": "object",
   "properties": {
    "word": {
     "type": "string",
     "pattern": "^w:[A-Za-z0-9]+:[A-Za-z0-9._-]+:\\d{6}$"
    },
    "lead_frames": {
     "type": "integer",
     "minimum": 0,
     "maximum": 90
    }
   },
   "required": [
    "word",
    "lead_frames"
   ],
   "additionalProperties": false
  },
  "txns": {
   "minItems": 2,
   "maxItems": 4,
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,31}$"
     },
     "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[^\\u0660-\\u0669\\u06F0-\\u06F9]*$"
     }
    },
    "required": [
     "id",
     "label"
    ],
    "additionalProperties": false
   }
  },
  "resources": {
   "minItems": 2,
   "maxItems": 4,
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,31}$"
     },
     "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[^\\u0660-\\u0669\\u06F0-\\u06F9]*$"
     }
    },
    "required": [
     "id",
     "label"
    ],
    "additionalProperties": false
   }
  },
  "holds": {
   "minItems": 0,
   "maxItems": 8,
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "txn": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,31}$"
     },
     "res": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,31}$"
     }
    },
    "required": [
     "txn",
     "res"
    ],
    "additionalProperties": false
   }
  },
  "waits": {
   "minItems": 0,
   "maxItems": 8,
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "txn": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,31}$"
     },
     "res": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,31}$"
     }
    },
    "required": [
     "txn",
     "res"
    ],
    "additionalProperties": false
   }
  }
 },
 "required": [
  "txns",
  "resources",
  "holds",
  "waits"
 ],
 "additionalProperties": false,
 "$id": "dc:component:DeadlockCrossing",
 "title": "DeadlockCrossing",
 "description": "Transactions holding and waiting on resources until a victim is chosen.",
 "x-family": "Domain specials",
 "x-status": "frozen-contract",
 "x-impl": "P7",
 "x-actions": {
  "resolve": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "target": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    },
    "victim": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    }
   },
   "required": [
    "victim"
   ],
   "additionalProperties": false
  }
 }
}
