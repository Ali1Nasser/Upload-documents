{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_-]{0,31}$"
  },
  "slot": {
   "type": "string",
   "enum": [
    "full",
    "center",
    "start",
    "end",
    "top",
    "bottom",
    "upper-third",
    "lower-third"
   ]
  },
  "depth": {
   "type": "string",
   "enum": [
    "far",
    "mid",
    "near",
    "fg"
   ]
  },
  "until": {
   "type": "object",
   "properties": {
    "word": {
     "type": "string",
     "pattern": "^w:[A-Za-z0-9]+:[A-Za-z0-9._-]+:\\d{6}$"
    },
    "lead_frames": {
     "type": "integer",
     "minimum": 0,
     "maximum": 90
    }
   },
   "required": [
    "word",
    "lead_frames"
   ],
   "additionalProperties": false
  },
  "fact": {
   "type": "object",
   "properties": {
    "name": {
     "type": "string",
     "minLength": 1,
     "maxLength": 40,
     "pattern": "^[^\\u0660-\\u0669\\u06F0-\\u06F9]*$"
    },
    "measures": {
     "minItems": 1,
     "maxItems": 6,
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[^\\u0660-\\u0669\\u06F0-\\u06F9]*$"
     }
    }
   },
   "required": [
    "name",
    "measures"
   ],
   "additionalProperties": false
  },
  "dims": {
   "minItems": 2,
   "maxItems": 8,
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[^\\u0660-\\u0669\\u06F0-\\u06F9]*$"
     },
     "attrs": {
      "minItems": 1,
      "maxItems": 6,
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1,
       "maxLength": 40,
       "pattern": "^[^\\u0660-\\u0669\\u06F0-\\u06F9]*$"
      }
     }
    },
    "required": [
     "name",
     "attrs"
    ],
    "additionalProperties": false
   }
  }
 },
 "required": [
  "fact",
  "dims"
 ],
 "additionalProperties": false,
 "$id": "dc:component:StarSchema3D",
 "title": "StarSchema3D",
 "description": "A fact table with dimension tables in 3D.",
 "x-family": "Structure & flow",
 "x-status": "frozen-contract",
 "x-impl": "P7",
 "x-actions": {
  "focusDim": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "target": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    },
    "name": {
     "type": "string",
     "minLength": 1,
     "maxLength": 40,
     "pattern": "^[^\\u0660-\\u0669\\u06F0-\\u06F9]*$"
    }
   },
   "required": [
    "name"
   ],
   "additionalProperties": false
  }
 }
}
