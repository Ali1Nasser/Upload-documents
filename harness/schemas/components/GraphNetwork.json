{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_-]{0,31}$"
  },
  "slot": {
   "type": "string",
   "enum": [
    "full",
    "center",
    "start",
    "end",
    "top",
    "bottom",
    "upper-third",
    "lower-third"
   ]
  },
  "depth": {
   "type": "string",
   "enum": [
    "far",
    "mid",
    "near",
    "fg"
   ]
  },
  "until": {
   "type": "object",
   "properties": {
    "word": {
     "type": "string",
     "pattern": "^w:[A-Za-z0-9]+:[A-Za-z0-9._-]+:\\d{6}$"
    },
    "lead_frames": {
     "type": "integer",
     "minimum": 0,
     "maximum": 90
    }
   },
   "required": [
    "word",
    "lead_frames"
   ],
   "additionalProperties": false
  },
  "nodes": {
   "minItems": 1,
   "maxItems": 60,
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,31}$"
     },
     "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[^\\u0660-\\u0669\\u06F0-\\u06F9]*$"
     },
     "group": {
      "type": "string",
      "maxLength": 24
     }
    },
    "required": [
     "id",
     "label"
    ],
    "additionalProperties": false
   }
  },
  "edges": {
   "minItems": 0,
   "maxItems": 120,
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "from": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,31}$"
     },
     "to": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,31}$"
     },
     "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[^\\u0660-\\u0669\\u06F0-\\u06F9]*$"
     },
     "directed": {
      "default": true,
      "type": "boolean"
     }
    },
    "required": [
     "from",
     "to"
    ],
    "additionalProperties": false
   }
  },
  "layout": {
   "default": "force",
   "type": "string",
   "enum": [
    "force",
    "radial",
    "layered",
    "circle"
   ]
  },
  "seed": {
   "type": "integer",
   "minimum": 0,
   "maximum": 2147483647
  }
 },
 "required": [
  "nodes",
  "edges",
  "seed"
 ],
 "additionalProperties": false,
 "$id": "dc:component:GraphNetwork",
 "title": "GraphNetwork",
 "description": "Nodes and edges (seeded layout).",
 "x-family": "Structure & flow",
 "x-status": "frozen-contract",
 "x-impl": "P7",
 "x-actions": {
  "highlightPath": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "target": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    },
    "nodes": {
     "minItems": 1,
     "maxItems": 60,
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,31}$"
     }
    }
   },
   "required": [
    "nodes"
   ],
   "additionalProperties": false
  },
  "pulseNode": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "target": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    },
    "node": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    }
   },
   "required": [
    "node"
   ],
   "additionalProperties": false
  },
  "addEdge": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "target": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    },
    "from": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    },
    "to": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    }
   },
   "required": [
    "from",
    "to"
   ],
   "additionalProperties": false
  }
 }
}
