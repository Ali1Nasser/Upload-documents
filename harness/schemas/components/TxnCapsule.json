{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_-]{0,31}$"
  },
  "slot": {
   "type": "string",
   "enum": [
    "full",
    "center",
    "start",
    "end",
    "top",
    "bottom",
    "upper-third",
    "lower-third"
   ]
  },
  "depth": {
   "type": "string",
   "enum": [
    "far",
    "mid",
    "near",
    "fg"
   ]
  },
  "until": {
   "type": "object",
   "properties": {
    "word": {
     "type": "string",
     "pattern": "^w:[A-Za-z0-9]+:[A-Za-z0-9._-]+:\\d{6}$"
    },
    "lead_frames": {
     "type": "integer",
     "minimum": 0,
     "maximum": 90
    }
   },
   "required": [
    "word",
    "lead_frames"
   ],
   "additionalProperties": false
  },
  "ops": {
   "minItems": 1,
   "maxItems": 8,
   "type": "array",
   "items": {
    "type": "string",
    "maxLength": 48
   }
  },
  "isolation": {
   "type": "string",
   "enum": [
    "read_uncommitted",
    "read_committed",
    "repeatable_read",
    "serializable"
   ]
  },
  "outcome": {
   "type": "string",
   "enum": [
    "commit",
    "rollback"
   ]
  }
 },
 "required": [
  "ops"
 ],
 "additionalProperties": false,
 "$id": "dc:component:TxnCapsule",
 "title": "TxnCapsule",
 "description": "A transaction capsule of operations that commits or rolls back.",
 "x-family": "Domain specials",
 "x-status": "frozen-contract",
 "x-impl": "P7",
 "x-actions": {
  "commit": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "target": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    }
   },
   "additionalProperties": false
  },
  "rollback": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "target": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    }
   },
   "additionalProperties": false
  }
 }
}
