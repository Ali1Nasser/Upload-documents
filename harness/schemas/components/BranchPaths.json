{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_-]{0,31}$"
  },
  "slot": {
   "type": "string",
   "enum": [
    "full",
    "center",
    "start",
    "end",
    "top",
    "bottom",
    "upper-third",
    "lower-third"
   ]
  },
  "depth": {
   "type": "string",
   "enum": [
    "far",
    "mid",
    "near",
    "fg"
   ]
  },
  "until": {
   "type": "object",
   "properties": {
    "word": {
     "type": "string",
     "pattern": "^w:[A-Za-z0-9]+:[A-Za-z0-9._-]+:\\d{6}$"
    },
    "lead_frames": {
     "type": "integer",
     "minimum": 0,
     "maximum": 90
    }
   },
   "required": [
    "word",
    "lead_frames"
   ],
   "additionalProperties": false
  },
  "question": {
   "type": "string",
   "minLength": 1,
   "maxLength": 80,
   "pattern": "^[^\\u0660-\\u0669\\u06F0-\\u06F9]*$"
  },
  "branches": {
   "minItems": 2,
   "maxItems": 4,
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[^\\u0660-\\u0669\\u06F0-\\u06F9]*$"
     },
     "outcome": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[^\\u0660-\\u0669\\u06F0-\\u06F9]*$"
     },
     "status": {
      "type": "string",
      "enum": [
       "idle",
       "active",
       "ok",
       "warn",
       "fail"
      ]
     }
    },
    "required": [
     "label",
     "outcome"
    ],
    "additionalProperties": false
   }
  }
 },
 "required": [
  "question",
  "branches"
 ],
 "additionalProperties": false,
 "$id": "dc:component:BranchPaths",
 "title": "BranchPaths",
 "description": "A question that forks into 2-4 paths with outcomes.",
 "x-family": "Domain specials",
 "x-status": "frozen-contract",
 "x-impl": "P7",
 "x-actions": {
  "choose": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "target": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    },
    "index": {
     "type": "integer",
     "minimum": 0,
     "maximum": 3
    }
   },
   "required": [
    "index"
   ],
   "additionalProperties": false
  }
 }
}
