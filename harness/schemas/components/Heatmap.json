{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_-]{0,31}$"
  },
  "slot": {
   "type": "string",
   "enum": [
    "full",
    "center",
    "start",
    "end",
    "top",
    "bottom",
    "upper-third",
    "lower-third"
   ]
  },
  "depth": {
   "type": "string",
   "enum": [
    "far",
    "mid",
    "near",
    "fg"
   ]
  },
  "until": {
   "type": "object",
   "properties": {
    "word": {
     "type": "string",
     "pattern": "^w:[A-Za-z0-9]+:[A-Za-z0-9._-]+:\\d{6}$"
    },
    "lead_frames": {
     "type": "integer",
     "minimum": 0,
     "maximum": 90
    }
   },
   "required": [
    "word",
    "lead_frames"
   ],
   "additionalProperties": false
  },
  "x": {
   "minItems": 1,
   "maxItems": 24,
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1,
    "maxLength": 40,
    "pattern": "^[^\\u0660-\\u0669\\u06F0-\\u06F9]*$"
   }
  },
  "y": {
   "minItems": 1,
   "maxItems": 24,
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1,
    "maxLength": 40,
    "pattern": "^[^\\u0660-\\u0669\\u06F0-\\u06F9]*$"
   }
  },
  "values": {
   "maxItems": 24,
   "type": "array",
   "items": {
    "maxItems": 24,
    "type": "array",
    "items": {
     "type": "number"
    }
   }
  },
  "ref": {
   "anyOf": [
    {
     "type": "string",
     "pattern": "^d:\\d+(\\.\\d+)*:\\d+$"
    },
    {
     "type": "string",
     "pattern": "^s:[A-Za-z0-9]+:[A-Za-z0-9._-]+:\\d{4}$"
    }
   ]
  },
  "scale": {
   "default": "sequential",
   "type": "string",
   "enum": [
    "sequential",
    "diverging"
   ]
  }
 },
 "required": [
  "x",
  "y",
  "values",
  "ref"
 ],
 "additionalProperties": false,
 "$id": "dc:component:Heatmap",
 "title": "Heatmap",
 "description": "A labelled matrix of values on a sequential or diverging token scale.",
 "x-family": "Data",
 "x-status": "frozen-contract",
 "x-impl": "P7",
 "x-actions": {
  "highlightCell": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "target": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    },
    "x": {
     "type": "integer",
     "minimum": 0,
     "maximum": 23
    },
    "y": {
     "type": "integer",
     "minimum": 0,
     "maximum": 23
    }
   },
   "required": [
    "x",
    "y"
   ],
   "additionalProperties": false
  }
 }
}
