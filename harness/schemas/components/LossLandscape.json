{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_-]{0,31}$"
  },
  "slot": {
   "type": "string",
   "enum": [
    "full",
    "center",
    "start",
    "end",
    "top",
    "bottom",
    "upper-third",
    "lower-third"
   ]
  },
  "depth": {
   "type": "string",
   "enum": [
    "far",
    "mid",
    "near",
    "fg"
   ]
  },
  "until": {
   "type": "object",
   "properties": {
    "word": {
     "type": "string",
     "pattern": "^w:[A-Za-z0-9]+:[A-Za-z0-9._-]+:\\d{6}$"
    },
    "lead_frames": {
     "type": "integer",
     "minimum": 0,
     "maximum": 90
    }
   },
   "required": [
    "word",
    "lead_frames"
   ],
   "additionalProperties": false
  },
  "kind": {
   "type": "string",
   "enum": [
    "convex",
    "nonconvex",
    "saddle"
   ]
  },
  "seed": {
   "type": "integer",
   "minimum": 0,
   "maximum": 2147483647
  },
  "steps": {
   "default": 20,
   "type": "integer",
   "minimum": 1,
   "maximum": 60
  },
  "lr": {
   "type": "object",
   "properties": {
    "value": {
     "type": "number"
    },
    "ref": {
     "anyOf": [
      {
       "type": "string",
       "pattern": "^d:\\d+(\\.\\d+)*:\\d+$"
      },
      {
       "type": "string",
       "pattern": "^s:[A-Za-z0-9]+:[A-Za-z0-9._-]+:\\d{4}$"
      }
     ]
    },
    "unit": {
     "type": "string",
     "maxLength": 12
    },
    "decimals": {
     "type": "integer",
     "minimum": 0,
     "maximum": 4
    }
   },
   "required": [
    "value",
    "ref"
   ],
   "additionalProperties": false
  }
 },
 "required": [
  "kind",
  "seed"
 ],
 "additionalProperties": false,
 "$id": "dc:component:LossLandscape",
 "title": "LossLandscape",
 "description": "A loss surface with an optimiser path (seeded).",
 "x-family": "Space & 3D",
 "x-status": "frozen-contract",
 "x-impl": "P7",
 "x-actions": {
  "step": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "target": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    },
    "n": {
     "type": "integer",
     "minimum": 1,
     "maximum": 60
    }
   },
   "required": [
    "n"
   ],
   "additionalProperties": false
  },
  "overshoot": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "target": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    }
   },
   "additionalProperties": false
  }
 }
}
