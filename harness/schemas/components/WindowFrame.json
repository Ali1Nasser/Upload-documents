{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_-]{0,31}$"
  },
  "slot": {
   "type": "string",
   "enum": [
    "full",
    "center",
    "start",
    "end",
    "top",
    "bottom",
    "upper-third",
    "lower-third"
   ]
  },
  "depth": {
   "type": "string",
   "enum": [
    "far",
    "mid",
    "near",
    "fg"
   ]
  },
  "until": {
   "type": "object",
   "properties": {
    "word": {
     "type": "string",
     "pattern": "^w:[A-Za-z0-9]+:[A-Za-z0-9._-]+:\\d{6}$"
    },
    "lead_frames": {
     "type": "integer",
     "minimum": 0,
     "maximum": 90
    }
   },
   "required": [
    "word",
    "lead_frames"
   ],
   "additionalProperties": false
  },
  "partition_by": {
   "type": "string",
   "maxLength": 40
  },
  "order_by": {
   "type": "string",
   "maxLength": 40
  },
  "frame_kind": {
   "type": "string",
   "enum": [
    "rows",
    "range",
    "groups"
   ]
  },
  "bounds": {
   "type": "array",
   "prefixItems": [
    {
     "type": "string",
     "maxLength": 24
    },
    {
     "type": "string",
     "maxLength": 24
    }
   ],
   "items": false,
   "minItems": 2,
   "maxItems": 2
  },
  "values": {
   "minItems": 1,
   "maxItems": 16,
   "type": "array",
   "items": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "string",
      "maxLength": 16
     }
    ]
   }
  },
  "ref": {
   "anyOf": [
    {
     "type": "string",
     "pattern": "^d:\\d+(\\.\\d+)*:\\d+$"
    },
    {
     "type": "string",
     "pattern": "^s:[A-Za-z0-9]+:[A-Za-z0-9._-]+:\\d{4}$"
    }
   ]
  }
 },
 "required": [
  "order_by",
  "frame_kind",
  "bounds",
  "values"
 ],
 "additionalProperties": false,
 "$id": "dc:component:WindowFrame",
 "title": "WindowFrame",
 "description": "A window function frame sliding over ordered rows of a partition.",
 "x-family": "Data",
 "x-status": "frozen-contract",
 "x-impl": "P7",
 "x-actions": {
  "slide": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "target": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    },
    "to": {
     "type": "integer",
     "minimum": 0,
     "maximum": 15
    }
   },
   "required": [
    "to"
   ],
   "additionalProperties": false
  }
 }
}
