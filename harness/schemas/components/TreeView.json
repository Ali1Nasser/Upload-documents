{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_-]{0,31}$"
  },
  "slot": {
   "type": "string",
   "enum": [
    "full",
    "center",
    "start",
    "end",
    "top",
    "bottom",
    "upper-third",
    "lower-third"
   ]
  },
  "depth": {
   "type": "string",
   "enum": [
    "far",
    "mid",
    "near",
    "fg"
   ]
  },
  "until": {
   "type": "object",
   "properties": {
    "word": {
     "type": "string",
     "pattern": "^w:[A-Za-z0-9]+:[A-Za-z0-9._-]+:\\d{6}$"
    },
    "lead_frames": {
     "type": "integer",
     "minimum": 0,
     "maximum": 90
    }
   },
   "required": [
    "word",
    "lead_frames"
   ],
   "additionalProperties": false
  },
  "variant": {
   "type": "string",
   "enum": [
    "btree",
    "plan",
    "decision",
    "fs"
   ]
  },
  "nodes": {
   "minItems": 1,
   "maxItems": 63,
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,31}$"
     },
     "parent": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,31}$"
     },
     "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[^\\u0660-\\u0669\\u06F0-\\u06F9]*$"
     },
     "kind": {
      "type": "string",
      "maxLength": 16
     }
    },
    "required": [
     "id",
     "label"
    ],
    "additionalProperties": false
   }
  }
 },
 "required": [
  "variant",
  "nodes"
 ],
 "additionalProperties": false,
 "$id": "dc:component:TreeView",
 "title": "TreeView",
 "description": "A tree as a flat parent list: variant btree | plan | decision | fs.",
 "x-family": "Structure & flow",
 "x-status": "frozen-contract",
 "x-impl": "P7",
 "x-actions": {
  "expand": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "target": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    },
    "node": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    }
   },
   "required": [
    "node"
   ],
   "additionalProperties": false
  },
  "highlightPath": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "target": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    },
    "nodes": {
     "minItems": 1,
     "maxItems": 12,
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,31}$"
     }
    }
   },
   "required": [
    "nodes"
   ],
   "additionalProperties": false
  },
  "search": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "target": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    },
    "key": {
     "type": "string",
     "minLength": 1,
     "maxLength": 40,
     "pattern": "^[^\\u0660-\\u0669\\u06F0-\\u06F9]*$"
    }
   },
   "required": [
    "key"
   ],
   "additionalProperties": false
  }
 }
}
