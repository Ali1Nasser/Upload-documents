{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_-]{0,31}$"
  },
  "slot": {
   "type": "string",
   "enum": [
    "full",
    "center",
    "start",
    "end",
    "top",
    "bottom",
    "upper-third",
    "lower-third"
   ]
  },
  "depth": {
   "type": "string",
   "enum": [
    "far",
    "mid",
    "near",
    "fg"
   ]
  },
  "until": {
   "type": "object",
   "properties": {
    "word": {
     "type": "string",
     "pattern": "^w:[A-Za-z0-9]+:[A-Za-z0-9._-]+:\\d{6}$"
    },
    "lead_frames": {
     "type": "integer",
     "minimum": 0,
     "maximum": 90
    }
   },
   "required": [
    "word",
    "lead_frames"
   ],
   "additionalProperties": false
  },
  "pool_size": {
   "type": "integer",
   "minimum": 1,
   "maximum": 20
  },
  "requests": {
   "type": "integer",
   "minimum": 0,
   "maximum": 40
  },
  "seed": {
   "type": "integer",
   "minimum": 0,
   "maximum": 2147483647
  }
 },
 "required": [
  "pool_size",
  "requests",
  "seed"
 ],
 "additionalProperties": false,
 "$id": "dc:component:ConnPoolTaxi",
 "title": "ConnPoolTaxi",
 "description": "A connection pool as a taxi rank; requests queue when exhausted.",
 "x-family": "Domain specials",
 "x-status": "frozen-contract",
 "x-impl": "P7",
 "x-actions": {
  "exhaust": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "target": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    }
   },
   "additionalProperties": false
  },
  "release": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "target": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    },
    "n": {
     "type": "integer",
     "minimum": 1,
     "maximum": 20
    }
   },
   "required": [
    "n"
   ],
   "additionalProperties": false
  }
 }
}
