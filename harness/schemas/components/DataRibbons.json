{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_-]{0,31}$"
  },
  "slot": {
   "type": "string",
   "enum": [
    "full",
    "center",
    "start",
    "end",
    "top",
    "bottom",
    "upper-third",
    "lower-third"
   ]
  },
  "depth": {
   "type": "string",
   "enum": [
    "far",
    "mid",
    "near",
    "fg"
   ]
  },
  "until": {
   "type": "object",
   "properties": {
    "word": {
     "type": "string",
     "pattern": "^w:[A-Za-z0-9]+:[A-Za-z0-9._-]+:\\d{6}$"
    },
    "lead_frames": {
     "type": "integer",
     "minimum": 0,
     "maximum": 90
    }
   },
   "required": [
    "word",
    "lead_frames"
   ],
   "additionalProperties": false
  },
  "ribbons": {
   "minItems": 1,
   "maxItems": 8,
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[^\\u0660-\\u0669\\u06F0-\\u06F9]*$"
     },
     "color": {
      "type": "string",
      "enum": [
       "void",
       "ground",
       "panel",
       "grid",
       "ink",
       "ink2",
       "ink3",
       "signal",
       "ok",
       "warn",
       "crit",
       "violet",
       "ember",
       "paper",
       "paperShade",
       "paperInk",
       "paperOk",
       "paperCrit",
       "white"
      ]
     }
    },
    "required": [
     "color"
    ],
    "additionalProperties": false
   }
  },
  "flow": {
   "type": "string",
   "enum": [
    "converge",
    "diverge",
    "parallel"
   ]
  },
  "seed": {
   "type": "integer",
   "minimum": 0,
   "maximum": 2147483647
  }
 },
 "required": [
  "ribbons",
  "flow",
  "seed"
 ],
 "additionalProperties": false,
 "$id": "dc:component:DataRibbons",
 "title": "DataRibbons",
 "description": "Flowing ribbons that converge, diverge or run parallel.",
 "x-family": "Space & 3D",
 "x-status": "frozen-contract",
 "x-impl": "P7",
 "x-actions": {}
}
