{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_-]{0,31}$"
  },
  "slot": {
   "type": "string",
   "enum": [
    "full",
    "center",
    "start",
    "end",
    "top",
    "bottom",
    "upper-third",
    "lower-third"
   ]
  },
  "depth": {
   "type": "string",
   "enum": [
    "far",
    "mid",
    "near",
    "fg"
   ]
  },
  "until": {
   "type": "object",
   "properties": {
    "word": {
     "type": "string",
     "pattern": "^w:[A-Za-z0-9]+:[A-Za-z0-9._-]+:\\d{6}$"
    },
    "lead_frames": {
     "type": "integer",
     "minimum": 0,
     "maximum": 90
    }
   },
   "required": [
    "word",
    "lead_frames"
   ],
   "additionalProperties": false
  },
  "clip": {
   "type": "string",
   "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
  },
  "alpha": {
   "default": true,
   "type": "boolean"
  },
  "fit": {
   "default": "contain",
   "type": "string",
   "enum": [
    "contain",
    "cover"
   ]
  }
 },
 "required": [
  "clip"
 ],
 "additionalProperties": false,
 "$id": "dc:component:ManimInsert",
 "title": "ManimInsert",
 "description": "A Manim alpha-video insert.",
 "x-family": "Media",
 "x-status": "frozen-contract",
 "x-impl": "P7",
 "x-actions": {}
}
