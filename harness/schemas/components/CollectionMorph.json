{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_-]{0,31}$"
  },
  "slot": {
   "type": "string",
   "enum": [
    "full",
    "center",
    "start",
    "end",
    "top",
    "bottom",
    "upper-third",
    "lower-third"
   ]
  },
  "depth": {
   "type": "string",
   "enum": [
    "far",
    "mid",
    "near",
    "fg"
   ]
  },
  "until": {
   "type": "object",
   "properties": {
    "word": {
     "type": "string",
     "pattern": "^w:[A-Za-z0-9]+:[A-Za-z0-9._-]+:\\d{6}$"
    },
    "lead_frames": {
     "type": "integer",
     "minimum": 0,
     "maximum": 90
    }
   },
   "required": [
    "word",
    "lead_frames"
   ],
   "additionalProperties": false
  },
  "from": {
   "type": "string",
   "enum": [
    "list",
    "tuple",
    "set",
    "dict",
    "array",
    "dataframe",
    "series",
    "json"
   ]
  },
  "to": {
   "type": "string",
   "enum": [
    "list",
    "tuple",
    "set",
    "dict",
    "array",
    "dataframe",
    "series",
    "json"
   ]
  },
  "items": {
   "minItems": 1,
   "maxItems": 12,
   "type": "array",
   "items": {
    "type": "string",
    "maxLength": 24
   }
  }
 },
 "required": [
  "from",
  "to",
  "items"
 ],
 "additionalProperties": false,
 "$id": "dc:component:CollectionMorph",
 "title": "CollectionMorph",
 "description": "A collection morphing between types (list -> set -> dict ...).",
 "x-family": "Domain specials",
 "x-status": "frozen-contract",
 "x-impl": "P7",
 "x-actions": {}
}
