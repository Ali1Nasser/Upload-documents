{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_-]{0,31}$"
  },
  "slot": {
   "type": "string",
   "enum": [
    "full",
    "center",
    "start",
    "end",
    "top",
    "bottom",
    "upper-third",
    "lower-third"
   ]
  },
  "depth": {
   "type": "string",
   "enum": [
    "far",
    "mid",
    "near",
    "fg"
   ]
  },
  "until": {
   "type": "object",
   "properties": {
    "word": {
     "type": "string",
     "pattern": "^w:[A-Za-z0-9]+:[A-Za-z0-9._-]+:\\d{6}$"
    },
    "lead_frames": {
     "type": "integer",
     "minimum": 0,
     "maximum": 90
    }
   },
   "required": [
    "word",
    "lead_frames"
   ],
   "additionalProperties": false
  },
  "layers": {
   "minItems": 2,
   "maxItems": 8,
   "type": "array",
   "items": {
    "type": "integer",
    "minimum": 1,
    "maximum": 32
   }
  },
  "labels": {
   "minItems": 2,
   "maxItems": 8,
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1,
    "maxLength": 40,
    "pattern": "^[^\\u0660-\\u0669\\u06F0-\\u06F9]*$"
   }
  }
 },
 "required": [
  "layers"
 ],
 "additionalProperties": false,
 "$id": "dc:component:NeuralNet3D",
 "title": "NeuralNet3D",
 "description": "Layers of neurons (<= 32 per layer) with forward/backprop pulses.",
 "x-family": "Space & 3D",
 "x-status": "frozen-contract",
 "x-impl": "P7",
 "x-actions": {
  "forward": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "target": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    }
   },
   "additionalProperties": false
  },
  "backprop": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "target": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    }
   },
   "additionalProperties": false
  },
  "highlightLayer": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "target": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    },
    "index": {
     "type": "integer",
     "minimum": 0,
     "maximum": 7
    }
   },
   "required": [
    "index"
   ],
   "additionalProperties": false
  }
 }
}
