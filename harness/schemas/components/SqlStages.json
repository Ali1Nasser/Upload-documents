{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_-]{0,31}$"
  },
  "slot": {
   "type": "string",
   "enum": [
    "full",
    "center",
    "start",
    "end",
    "top",
    "bottom",
    "upper-third",
    "lower-third"
   ]
  },
  "depth": {
   "type": "string",
   "enum": [
    "far",
    "mid",
    "near",
    "fg"
   ]
  },
  "until": {
   "type": "object",
   "properties": {
    "word": {
     "type": "string",
     "pattern": "^w:[A-Za-z0-9]+:[A-Za-z0-9._-]+:\\d{6}$"
    },
    "lead_frames": {
     "type": "integer",
     "minimum": 0,
     "maximum": 90
    }
   },
   "required": [
    "word",
    "lead_frames"
   ],
   "additionalProperties": false
  },
  "query": {
   "type": "string",
   "minLength": 1,
   "maxLength": 1200
  },
  "stages": {
   "minItems": 1,
   "maxItems": 10,
   "type": "array",
   "items": {
    "type": "string",
    "enum": [
     "FROM",
     "JOIN",
     "WHERE",
     "GROUP BY",
     "HAVING",
     "WINDOW",
     "SELECT",
     "DISTINCT",
     "ORDER BY",
     "LIMIT"
    ]
   }
  }
 },
 "required": [
  "query",
  "stages"
 ],
 "additionalProperties": false,
 "$id": "dc:component:SqlStages",
 "title": "SqlStages",
 "description": "A SQL query split into its logical execution stages, lit in execution order.",
 "x-family": "Code",
 "x-status": "frozen-contract",
 "x-impl": "P7",
 "x-actions": {
  "activate": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "target": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    },
    "stage": {
     "type": "string",
     "enum": [
      "FROM",
      "JOIN",
      "WHERE",
      "GROUP BY",
      "HAVING",
      "WINDOW",
      "SELECT",
      "DISTINCT",
      "ORDER BY",
      "LIMIT"
     ]
    }
   },
   "required": [
    "stage"
   ],
   "additionalProperties": false
  }
 }
}
