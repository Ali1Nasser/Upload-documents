{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_-]{0,31}$"
  },
  "slot": {
   "type": "string",
   "enum": [
    "full",
    "center",
    "start",
    "end",
    "top",
    "bottom",
    "upper-third",
    "lower-third"
   ]
  },
  "depth": {
   "type": "string",
   "enum": [
    "far",
    "mid",
    "near",
    "fg"
   ]
  },
  "until": {
   "type": "object",
   "properties": {
    "word": {
     "type": "string",
     "pattern": "^w:[A-Za-z0-9]+:[A-Za-z0-9._-]+:\\d{6}$"
    },
    "lead_frames": {
     "type": "integer",
     "minimum": 0,
     "maximum": 90
    }
   },
   "required": [
    "word",
    "lead_frames"
   ],
   "additionalProperties": false
  },
  "topic": {
   "type": "string",
   "minLength": 1,
   "maxLength": 40,
   "pattern": "^[^\\u0660-\\u0669\\u06F0-\\u06F9]*$"
  },
  "partitions": {
   "type": "integer",
   "minimum": 1,
   "maximum": 12
  },
  "consumers": {
   "minItems": 0,
   "maxItems": 8,
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,31}$"
     },
     "group": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[^\\u0660-\\u0669\\u06F0-\\u06F9]*$"
     },
     "lanes": {
      "minItems": 0,
      "maxItems": 12,
      "type": "array",
      "items": {
       "type": "integer",
       "minimum": 0,
       "maximum": 11
      }
     }
    },
    "required": [
     "id",
     "lanes"
    ],
    "additionalProperties": false
   }
  },
  "messages": {
   "default": 12,
   "type": "integer",
   "minimum": 0,
   "maximum": 40
  },
  "keyed": {
   "default": true,
   "type": "boolean"
  },
  "seed": {
   "type": "integer",
   "minimum": 0,
   "maximum": 2147483647
  }
 },
 "required": [
  "topic",
  "partitions",
  "consumers",
  "seed"
 ],
 "additionalProperties": false,
 "$id": "dc:component:PartitionLanes",
 "title": "PartitionLanes",
 "description": "Kafka-style topic partitions as lanes with consumers, offsets and lag.",
 "x-family": "Structure & flow",
 "x-status": "frozen-contract",
 "x-impl": "P7",
 "x-actions": {
  "produce": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "target": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    },
    "lane": {
     "type": "integer",
     "minimum": 0,
     "maximum": 11
    },
    "key": {
     "type": "string",
     "minLength": 1,
     "maxLength": 40,
     "pattern": "^[^\\u0660-\\u0669\\u06F0-\\u06F9]*$"
    }
   },
   "required": [
    "lane"
   ],
   "additionalProperties": false
  },
  "rebalance": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "target": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    },
    "assign": {
     "minItems": 1,
     "maxItems": 8,
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "consumer": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,31}$"
       },
       "lanes": {
        "minItems": 0,
        "maxItems": 12,
        "type": "array",
        "items": {
         "type": "integer",
         "minimum": 0,
         "maximum": 11
        }
       }
      },
      "required": [
       "consumer",
       "lanes"
      ],
      "additionalProperties": false
     }
    }
   },
   "required": [
    "assign"
   ],
   "additionalProperties": false
  },
  "lag": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "target": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    },
    "lane": {
     "type": "integer",
     "minimum": 0,
     "maximum": 11
    },
    "value": {
     "type": "object",
     "properties": {
      "value": {
       "type": "number"
      },
      "ref": {
       "anyOf": [
        {
         "type": "string",
         "pattern": "^d:\\d+(\\.\\d+)*:\\d+$"
        },
        {
         "type": "string",
         "pattern": "^s:[A-Za-z0-9]+:[A-Za-z0-9._-]+:\\d{4}$"
        }
       ]
      },
      "unit": {
       "type": "string",
       "maxLength": 12
      },
      "decimals": {
       "type": "integer",
       "minimum": 0,
       "maximum": 4
      }
     },
     "required": [
      "value",
      "ref"
     ],
     "additionalProperties": false
    }
   },
   "required": [
    "lane",
    "value"
   ],
   "additionalProperties": false
  }
 }
}
