{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_-]{0,31}$"
  },
  "slot": {
   "type": "string",
   "enum": [
    "full",
    "center",
    "start",
    "end",
    "top",
    "bottom",
    "upper-third",
    "lower-third"
   ]
  },
  "depth": {
   "type": "string",
   "enum": [
    "far",
    "mid",
    "near",
    "fg"
   ]
  },
  "until": {
   "type": "object",
   "properties": {
    "word": {
     "type": "string",
     "pattern": "^w:[A-Za-z0-9]+:[A-Za-z0-9._-]+:\\d{6}$"
    },
    "lead_frames": {
     "type": "integer",
     "minimum": 0,
     "maximum": 90
    }
   },
   "required": [
    "word",
    "lead_frames"
   ],
   "additionalProperties": false
  },
  "items": {
   "minItems": 1,
   "maxItems": 20,
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[^\\u0660-\\u0669\\u06F0-\\u06F9]*$"
     },
     "status": {
      "type": "string",
      "enum": [
       "idle",
       "active",
       "ok",
       "warn",
       "fail"
      ]
     }
    },
    "required": [
     "label"
    ],
    "additionalProperties": false
   }
  },
  "stations": {
   "minItems": 1,
   "maxItems": 6,
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1,
    "maxLength": 40,
    "pattern": "^[^\\u0660-\\u0669\\u06F0-\\u06F9]*$"
   }
  },
  "speed": {
   "default": "normal",
   "type": "string",
   "enum": [
    "slow",
    "normal",
    "fast"
   ]
  }
 },
 "required": [
  "items"
 ],
 "additionalProperties": false,
 "$id": "dc:component:Conveyor",
 "title": "Conveyor",
 "description": "Items on a conveyor passing stations.",
 "x-family": "Structure & flow",
 "x-status": "frozen-contract",
 "x-impl": "P7",
 "x-actions": {
  "stop": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "target": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    }
   },
   "additionalProperties": false
  },
  "jam": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "target": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    },
    "index": {
     "type": "integer",
     "minimum": 0,
     "maximum": 19
    }
   },
   "required": [
    "index"
   ],
   "additionalProperties": false
  },
  "resume": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "target": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    }
   },
   "additionalProperties": false
  }
 }
}
