{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_-]{0,31}$"
  },
  "slot": {
   "type": "string",
   "enum": [
    "full",
    "center",
    "start",
    "end",
    "top",
    "bottom",
    "upper-third",
    "lower-third"
   ]
  },
  "depth": {
   "type": "string",
   "enum": [
    "far",
    "mid",
    "near",
    "fg"
   ]
  },
  "until": {
   "type": "object",
   "properties": {
    "word": {
     "type": "string",
     "pattern": "^w:[A-Za-z0-9]+:[A-Za-z0-9._-]+:\\d{6}$"
    },
    "lead_frames": {
     "type": "integer",
     "minimum": 0,
     "maximum": 90
    }
   },
   "required": [
    "word",
    "lead_frames"
   ],
   "additionalProperties": false
  },
  "left": {
   "type": "object",
   "properties": {
    "name": {
     "type": "string",
     "minLength": 1,
     "maxLength": 40,
     "pattern": "^[^\\u0660-\\u0669\\u06F0-\\u06F9]*$"
    },
    "keys": {
     "minItems": 1,
     "maxItems": 8,
     "type": "array",
     "items": {
      "type": "string",
      "maxLength": 24
     }
    }
   },
   "required": [
    "name",
    "keys"
   ],
   "additionalProperties": false
  },
  "right": {
   "type": "object",
   "properties": {
    "name": {
     "type": "string",
     "minLength": 1,
     "maxLength": 40,
     "pattern": "^[^\\u0660-\\u0669\\u06F0-\\u06F9]*$"
    },
    "keys": {
     "minItems": 1,
     "maxItems": 8,
     "type": "array",
     "items": {
      "type": "string",
      "maxLength": 24
     }
    }
   },
   "required": [
    "name",
    "keys"
   ],
   "additionalProperties": false
  },
  "on": {
   "type": "string",
   "maxLength": 40
  },
  "kind": {
   "type": "string",
   "enum": [
    "inner",
    "left",
    "right",
    "full",
    "anti",
    "semi",
    "cross"
   ]
  },
  "result_rows": {
   "type": "object",
   "properties": {
    "value": {
     "type": "number"
    },
    "ref": {
     "anyOf": [
      {
       "type": "string",
       "pattern": "^d:\\d+(\\.\\d+)*:\\d+$"
      },
      {
       "type": "string",
       "pattern": "^s:[A-Za-z0-9]+:[A-Za-z0-9._-]+:\\d{4}$"
      }
     ]
    },
    "unit": {
     "type": "string",
     "maxLength": 12
    },
    "decimals": {
     "type": "integer",
     "minimum": 0,
     "maximum": 4
    }
   },
   "required": [
    "value",
    "ref"
   ],
   "additionalProperties": false
  }
 },
 "required": [
  "left",
  "right",
  "on",
  "kind"
 ],
 "additionalProperties": false,
 "$id": "dc:component:JoinFusion",
 "title": "JoinFusion",
 "description": "Two tables fusing on a key; join kind decides which rows survive.",
 "x-family": "Data",
 "x-status": "frozen-contract",
 "x-impl": "P7",
 "x-actions": {
  "fuse": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "target": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    }
   },
   "additionalProperties": false
  },
  "showUnmatched": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "target": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    },
    "side": {
     "type": "string",
     "enum": [
      "left",
      "right",
      "both"
     ]
    }
   },
   "required": [
    "side"
   ],
   "additionalProperties": false
  }
 }
}
