{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dc:canon_coverage",
  "title": "corpus/canon/coverage_index.json (master.md §12)",
  "type": "object",
  "required": [
    "v",
    "source",
    "domains",
    "gaps",
    "primers"
  ],
  "properties": {
    "v": {
      "type": "integer",
      "minimum": 1
    },
    "source": {
      "type": "object",
      "required": [
        "path",
        "file_id"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "file_id": {
          "type": "string",
          "pattern": "^f:[0-9a-f]{12}$"
        }
      }
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "domain",
          "topics",
          "chapters"
        ],
        "properties": {
          "domain": {
            "type": "string"
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "chapters": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "gap",
          "closed_in"
        ],
        "properties": {
          "gap": {
            "type": "string"
          },
          "closed_in": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "primers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "q",
          "chapters"
        ],
        "properties": {
          "q": {
            "type": "string"
          },
          "chapters": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
