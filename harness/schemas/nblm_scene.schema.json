{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dc:nblm_scene",
  "title": "corpus/canon/nblm_scenes.jsonl record (T3 NotebookLM scenes)",
  "type": "object",
  "required": [
    "v",
    "scene_id",
    "part",
    "n",
    "kind",
    "title",
    "on_screen",
    "animation",
    "narration",
    "numbers",
    "terms",
    "questions",
    "src"
  ],
  "properties": {
    "v": {
      "type": "integer",
      "minimum": 1
    },
    "scene_id": {
      "type": "string",
      "pattern": "^P\\d\\d-sc\\d\\d$"
    },
    "part": {
      "type": "string",
      "pattern": "^P\\d\\d$"
    },
    "n": {
      "type": "integer"
    },
    "kind": {
      "enum": [
        "scene",
        "intro"
      ]
    },
    "title": {
      "type": "string"
    },
    "on_screen": {
      "type": "string"
    },
    "animation": {
      "type": "string"
    },
    "narration": {
      "type": "string"
    },
    "numbers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "terms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "src": {
      "type": "object",
      "required": [
        "path",
        "file_id",
        "line"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "file_id": {
          "type": "string",
          "pattern": "^f:[0-9a-f]{12}$"
        },
        "line": {
          "type": "integer"
        }
      }
    },
    "unified_match": {
      "type": [
        "boolean",
        "null"
      ]
    }
  }
}
