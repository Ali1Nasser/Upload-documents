{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dc:qa_report",
  "title": "reports/qa/<tier>/<chapter>.rN.json",
  "type": "object",
  "properties": {
    "v": {
      "type": "integer",
      "minimum": 1
    },
    "chapter": {
      "type": "string",
      "pattern": "^(CH-\\d{2}|DD-P\\d{2}(-\\d+)?)$"
    },
    "tier": {
      "type": "string",
      "enum": [
        "storyboard",
        "preview",
        "final"
      ]
    },
    "round": {
      "type": "integer",
      "minimum": 1
    },
    "metrics": {
      "type": "object"
    },
    "rubric": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "shot_id": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "major",
              "minor"
            ]
          },
          "problem": {
            "type": "string"
          },
          "fix_hint": {
            "type": "string"
          }
        },
        "required": [
          "severity",
          "problem"
        ]
      }
    },
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "revise"
      ]
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "v",
    "chapter",
    "tier",
    "round",
    "metrics",
    "verdict",
    "reviewer"
  ]
}
