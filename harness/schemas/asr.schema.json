{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dc:asr",
  "title": "transcripts/<audio>.asr.json (faster-whisper output, times absolute in the source file)",
  "type": "object",
  "properties": {
    "v": {
      "type": "integer",
      "minimum": 1
    },
    "audio_id": {
      "type": "string",
      "pattern": "^a:[A-Za-z0-9]+:[A-Za-z0-9._-]+$"
    },
    "model": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "params": {
      "type": "object"
    },
    "window": {
      "type": "object",
      "properties": {
        "start_s": {
          "type": "number",
          "minimum": 0
        },
        "end_s": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "start_s",
        "end_s"
      ]
    },
    "stats": {
      "type": "object"
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0
          },
          "start_ms": {
            "type": "integer",
            "minimum": 0
          },
          "end_ms": {
            "type": "integer",
            "minimum": 0
          },
          "text": {
            "type": "string"
          },
          "avg_logprob": {
            "type": "number"
          },
          "no_speech_prob": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "compression_ratio": {
            "type": "number"
          },
          "words": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "i": {
                  "type": "integer",
                  "minimum": 0
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "start_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "end_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "p": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "i",
                "text",
                "start_ms",
                "end_ms",
                "p"
              ]
            }
          }
        },
        "required": [
          "id",
          "start_ms",
          "end_ms",
          "text",
          "avg_logprob",
          "words"
        ]
      }
    }
  },
  "required": [
    "v",
    "audio_id",
    "model",
    "language",
    "window",
    "segments"
  ]
}
