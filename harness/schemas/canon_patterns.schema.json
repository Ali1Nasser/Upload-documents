{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dc:canon_patterns",
  "title": "corpus/canon/patterns.json (master.md §2)",
  "type": "object",
  "required": [
    "v",
    "source",
    "patterns"
  ],
  "properties": {
    "v": {
      "type": "integer",
      "minimum": 1
    },
    "source": {
      "type": "object",
      "required": [
        "path",
        "file_id"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "file_id": {
          "type": "string",
          "pattern": "^f:[0-9a-f]{12}$"
        }
      }
    },
    "patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "definition",
          "text",
          "chapters"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^P\\d\\d$"
          },
          "title": {
            "type": "string"
          },
          "definition": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "rules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "used_for": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "chapters": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
