{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dc:words",
  "title": "transcripts/<audio>.words.jsonl record",
  "type": "object",
  "properties": {
    "v": {
      "type": "integer",
      "minimum": 1
    },
    "word_id": {
      "type": "string",
      "pattern": "^w:[A-Za-z0-9]+:[A-Za-z0-9._-]+:\\d{6}$"
    },
    "audio_id": {
      "type": "string",
      "pattern": "^a:[A-Za-z0-9]+:[A-Za-z0-9._-]+$"
    },
    "i": {
      "type": "integer",
      "minimum": 0
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "norm": {
      "type": "string"
    },
    "start_ms": {
      "type": "integer",
      "minimum": 0
    },
    "end_ms": {
      "type": "integer",
      "minimum": 0
    },
    "conf": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "method": {
      "type": "string"
    },
    "is_term": {
      "type": "boolean"
    },
    "term": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "is_number": {
      "type": "boolean"
    },
    "prominence": {
      "type": "number"
    },
    "polish": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "orig": {
              "type": "string"
            },
            "rule": {
              "type": "string"
            }
          },
          "required": []
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "v",
    "word_id",
    "audio_id",
    "i",
    "text",
    "start_ms",
    "end_ms",
    "conf"
  ]
}
