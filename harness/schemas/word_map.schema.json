{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dc:word_map",
  "title": "edl/word_map.vN.jsonl record",
  "type": "object",
  "properties": {
    "word_id": {
      "type": "string",
      "pattern": "^w:[A-Za-z0-9]+:[A-Za-z0-9._-]+:\\d{6}$"
    },
    "rec_start_frame": {
      "type": "integer",
      "minimum": 0
    },
    "rec_end_frame": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "word_id",
    "rec_start_frame",
    "rec_end_frame"
  ]
}
