{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dc:visual_asset",
  "title": "visual/assets.jsonl record",
  "type": "object",
  "properties": {
    "v": {
      "type": "integer",
      "minimum": 1
    },
    "asset_id": {
      "type": "string",
      "pattern": "^v:[0-9a-f]{12}(@\\d+)?$"
    },
    "file_id": {
      "type": "string",
      "pattern": "^f:[0-9a-f]{12}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "slide",
        "legacy_shot",
        "hub_section",
        "mermaid",
        "code",
        "py_pattern",
        "png_scene",
        "render_keyframe"
      ]
    },
    "source": {
      "type": "string"
    },
    "t_ms": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "caption_en": {
      "type": "string"
    },
    "caption_ar": {
      "type": "string"
    },
    "ocr": {
      "type": "string"
    },
    "concepts": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^c:[a-z0-9]+(-[a-z0-9]+)*$"
      }
    },
    "layout": {
      "type": "string"
    },
    "reusable_idea": {
      "type": "string"
    },
    "reuse_mode": {
      "type": "string",
      "enum": [
        "reference",
        "data",
        "do-not-use"
      ]
    },
    "quality": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "text_seen": {
      "type": "string"
    },
    "numbers_seen": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "caption_src": {
      "type": "string",
      "enum": [
        "vision",
        "dom-text",
        "source-text",
        "legacy-data"
      ]
    },
    "reviewed": {
      "type": "string",
      "enum": [
        "pixels",
        "numbers"
      ],
      "description": "pixels: caption re-read against the picture; numbers: only text_seen/numbers_seen re-read (set from corpus/visual/recaptions.jsonl)"
    },
    "review_note": {
      "type": "string"
    },
    "caption_checked": {
      "type": "boolean",
      "description": "true only with reviewed=pixels"
    },
    "numbers_pixel_only": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ocr_conf": {
      "type": [
        "number",
        "null"
      ]
    }
  },
  "required": [
    "v",
    "asset_id",
    "file_id",
    "kind",
    "reuse_mode"
  ]
}
