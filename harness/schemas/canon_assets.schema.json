{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dc:canon_assets",
  "title": "corpus/canon/assets_registry.json (master.md §9)",
  "type": "object",
  "required": [
    "v",
    "source",
    "assets",
    "permitted_3d"
  ],
  "properties": {
    "v": {
      "type": "integer",
      "minimum": 1
    },
    "source": {
      "type": "object",
      "required": [
        "path",
        "file_id"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "file_id": {
          "type": "string",
          "pattern": "^f:[0-9a-f]{12}$"
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "asset",
          "built_in",
          "returns_in",
          "note"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^A-\\d\\d$"
          },
          "asset": {
            "type": "string"
          },
          "built_in": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "returns_in": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "note": {
            "type": "string"
          },
          "is_3d": {
            "type": "boolean"
          }
        }
      }
    },
    "permitted_3d": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "n",
          "chapters",
          "scene",
          "optional"
        ],
        "properties": {
          "n": {
            "type": "integer"
          },
          "chapters": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scene": {
            "type": "string"
          },
          "optional": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
