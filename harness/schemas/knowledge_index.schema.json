{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dc:knowledge_index",
  "title": "canon/knowledge_index.jsonl record (heading index of DA_Camp_KNOWLEDGE.md)",
  "type": "object",
  "properties": {
    "v": {
      "type": "integer",
      "minimum": 1
    },
    "section_id": {
      "type": "string",
      "pattern": "^K\\d{5}$"
    },
    "heading_path": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "byte_start": {
      "type": "integer",
      "minimum": 0
    },
    "byte_end": {
      "type": "integer",
      "minimum": 0
    },
    "chars": {
      "type": "integer",
      "minimum": 0
    },
    "level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "title": {
      "type": "string"
    },
    "part": {
      "type": "string"
    },
    "line": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "v",
    "section_id",
    "heading_path",
    "byte_start",
    "byte_end",
    "chars"
  ]
}
