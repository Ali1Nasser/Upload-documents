{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dc:canon_scripts",
  "title": "corpus/canon/scripts.json (registry of narration texts T1..T7)",
  "type": "object",
  "required": [
    "v",
    "scripts",
    "trunk_script"
  ],
  "properties": {
    "v": {
      "type": "integer",
      "minimum": 1
    },
    "scripts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "lang",
          "role",
          "files",
          "lineage"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^T\\d(-old)?$"
          },
          "name": {
            "type": "string"
          },
          "lang": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "role": {
            "type": "string"
          },
          "files": {
            "type": "array"
          },
          "lineage": {
            "type": "object"
          }
        }
      }
    },
    "trunk_script": {
      "type": "string"
    }
  }
}
